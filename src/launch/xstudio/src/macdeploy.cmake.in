set(APP_BUNDLE_DIR "@CMAKE_BINARY_DIR@/xSTUDIO.app")
set(APP_FFMPEG "${APP_BUNDLE_DIR}/Contents/MacOS/ffmpeg")
set(FIXUP_SCRIPT "@CMAKE_CURRENT_SOURCE_DIR@/fixup_macos_bundle.cmake")

function(run_checked)
    execute_process(
        COMMAND ${ARGV}
        RESULT_VARIABLE command_result
        OUTPUT_VARIABLE command_stdout
        ERROR_VARIABLE command_stderr
    )

    if(NOT command_result EQUAL 0)
        list(JOIN ARGV " " command_line)
        message(
            FATAL_ERROR
            "Command failed (${command_result}): ${command_line}\n"
            "stdout:\n${command_stdout}\n"
            "stderr:\n${command_stderr}"
        )
    endif()
endfunction()

if(EXISTS "${APP_FFMPEG}")
    execute_process(
        COMMAND otool -l "${APP_FFMPEG}"
        RESULT_VARIABLE ffmpeg_otool_result
        OUTPUT_VARIABLE ffmpeg_otool_output
        ERROR_VARIABLE ffmpeg_otool_error
    )

    if(NOT ffmpeg_otool_result EQUAL 0)
        message(FATAL_ERROR "Failed to inspect ffmpeg rpaths:\n${ffmpeg_otool_error}")
    endif()

    if(ffmpeg_otool_output MATCHES "path @loader_path/../../lib")
        run_checked(
            install_name_tool
            -rpath
            "@loader_path/../../lib"
            "@loader_path/../Frameworks"
            "${APP_FFMPEG}"
        )
    endif()
endif()

message("Running @macdeployqt_exe@ on ${APP_BUNDLE_DIR}")
run_checked(
    "@macdeployqt_exe@"
    "${APP_BUNDLE_DIR}"
    "-qmldir=@CMAKE_SOURCE_DIR@/ui"
)

run_checked(
    "${CMAKE_COMMAND}"
    "-DAPP_BUNDLE_DIR=${APP_BUNDLE_DIR}"
    "-DCODESIGN_IDENTITY=@XSTUDIO_MACOS_CODESIGN_IDENTITY@"
    "-DCODESIGN_ENTITLEMENTS=@XSTUDIO_MACOS_CODESIGN_ENTITLEMENTS_ABS@"
    "-DCODESIGN_ENABLE_HARDENED_RUNTIME=@XSTUDIO_MACOS_ENABLE_HARDENED_RUNTIME@"
    -P
    "${FIXUP_SCRIPT}"
)
